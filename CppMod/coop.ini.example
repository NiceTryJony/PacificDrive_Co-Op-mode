; Pacific Drive Coop: network
; role = host (driver) | client (passenger) | off
role=host
; IP host: address Radmin (26.x.x.x)
host_ip=26.x.x.x
port=47777
; Rear left seat relative to the driver's seat, cm: x forward (minus = back), y right, z up
seat_x=-95
seat_y=0
seat_z=40
; Rear right seat: the same, but from the driver's point reflected through the car's axis (y changes sign)
seat_right_x=-95
seat_right_y=0
seat_right_z=40
; While the Client is sitting, you can only press the doors and Gobbler's screen (0 - turn off)
restrict_interactions=1
; Inscription "Co-op: ..." on top of the game (0 - turn off)
; If there are overlays like RTSS/Afterburner nearby and the game crashes
status_overlay=1
; Car parts: 1 - The passenger sets/removes them, the Host accepts; 0 - prohibited (the passenger's edit is rolled back)
client_parts=1
; landing (ctrl+e): how many centimeters from the car's axis to the side you were sitting on (0 is the game's default position, placed on the roof)
exit_side_cm=23
