; Pacific Drive Coop: сеть (docs/WORKFLOW.md)
; role = host (водитель) | client (пассажир) | off
role=host
; IP хоста: 127.0.0.1 для теста на одном ПК, адрес Radmin (26.x.x.x) для двух ПК
host_ip=127.0.0.1
port=47777
; Заднее левое сиденье относительно места водителя, см: x вперёд (минус = назад), y вправо, z вверх
seat_x=-95
seat_y=0
seat_z=40
; Заднее правое сиденье: то же, но от точки водителя, отражённой через ось машины (y меняет знак)
seat_right_x=-95
seat_right_y=0
seat_right_z=40
; Пока Client сидит, нажимать можно только двери и экран Гобблера (0 — отключить)
restrict_interactions=1
; Камера сидящего пассажира поворачивается вместе с машиной, горизонт ровный (0 — камера стоит на месте, как в игре)
camera_follow=1
; Надпись "Co-op: ..." поверх игры (0 — выключить; если рядом оверлеи вроде RTSS/Afterburner и игра падает)
status_overlay=1
; Детали машины: 1 — пассажир ставит/снимает их, Host принимает; 0 — запрет (у пассажира правка откатывается)
client_parts=1
; Client, сидя в машине, управляет ею: шлёт Host-у газ и руль (0 — выключено; у Host значения игнорируются, если Client не шлёт)
client_drive=0
; Предмет в руке собеседника: 1 — показывать его работу (насадки, пламя, плазма, вращение); 0 — только модель
hand_fx=1
; Высадка (Ctrl+E): на сколько см от оси машины в сторону, с которой сидели (0 — штатная точка игры, ставит на крышу)
exit_side_cm=230
; HUD (Lua, применяется сразу при изменении файла; docs/design/HUD_PLAN.md): hud=0 — выключить
; hud_mode: lamp|compact|standard|detailed — размер при старте (в игре — клавиша hud_key: h|j|k|none, с Ctrl)
; hud_corner: tl|tr|bl|br; hud_text — размер в процентах (60..160); hud_bg — тёмность плашки (30..100); hud_fade=0 — не приглушать
; hud_notices: all|problems|off; hud_doors=1 — уведомления о дверях; hud_toast_sec (2..12); hud_toast_max (1..3)
; hud_mate=0 — без стрелки и расстояния; hud_banner=0 — без баннера «напарник ушёл»; hud_motion: full|reduced|off
hud=1
hud_mode=compact
hud_key=h
hud_corner=tr
hud_text=100
hud_bg=76
hud_fade=1
hud_notices=all
hud_doors=0
hud_toast_sec=4
hud_toast_max=3
hud_mate=1
; метка над напарником: полностью видна до hud_mate_fade_start м, к hud_mate_fade_end м гаснет совсем
hud_mate_fade_start=50
hud_mate_fade_end=75
hud_banner=1
hud_motion=full
